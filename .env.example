# Copy this file to .env (cp .env.example .env). The real .env is never committed.

# Database. Locally, a SQLite file inside ./data.
# In production (Vercel), the Turso URL: libsql://<db-name>-<user>.turso.io
DATABASE_URL=file:./data/almacen.db

# Turso access token. Leave it empty for the local file.
DATABASE_AUTH_TOKEN=
